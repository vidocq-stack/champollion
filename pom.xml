<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd"
         root="true">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.champollion</groupId>
    <artifactId>champollion-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Champollion</name>
    <description>Implémentation Jakarta JSON Processing 2.1 + Jakarta JSON Binding 3.0 — zéro dépendance, virtual threads, compilation statique (APT + plugin Maven)</description>
    <url>https://codeberg.org/Vidocq/champollion</url>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <scm>
        <url>https://codeberg.org/Vidocq/champollion</url>
        <connection>scm:git:https://codeberg.org/Vidocq/champollion.git</connection>
        <developerConnection>scm:git:git@forge.vidocq.dev:vidocq/champollion.git</developerConnection>
    </scm>

    <properties>
        <!-- Specs Jakarta -->
        <jakarta.json.version>2.1.3</jakarta.json.version>
        <jakarta.json.bind.version>3.0.1</jakarta.json.bind.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <jmh.version>1.37</jmh.version>
    </properties>

    <!--
        champollion-tck est volontairement HORS reactor (POM Model 4.0.0 standalone)
        pour contourner ShrinkWrap Maven Resolver 3.3 qui ne sait pas parser
        les POMs Model 4.1.0. Il sera invoqué par run-official-tck-jsonp.sh
        et run-official-tck-jsonb.sh après installation locale du reactor.
    -->
    <subprojects>
        <subproject>champollion-api</subproject>
        <subproject>champollion-jsonp</subproject>
        <subproject>champollion-jsonb</subproject>
        <subproject>champollion-protobuf</subproject>
        <subproject>champollion-protobuf-codegen</subproject>
        <subproject>champollion-protobuf-maven-plugin</subproject>
        <subproject>champollion-codegen-apt</subproject>
        <subproject>champollion-codegen-maven-plugin</subproject>
        <subproject>champollion-bench</subproject>
        <subproject>champollion-examples</subproject>
    </subprojects>

    <dependencyManagement>
        <dependencies>
            <!-- Jakarta APIs -->
            <dependency>
                <groupId>jakarta.json</groupId>
                <artifactId>jakarta.json-api</artifactId>
                <version>${jakarta.json.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.json.bind</groupId>
                <artifactId>jakarta.json.bind-api</artifactId>
                <version>${jakarta.json.bind.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            <!-- JMH -->
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>

            <!-- Champollion modules internes -->
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-jsonp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-jsonb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-codegen-apt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-codegen-maven-plugin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-protobuf</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-protobuf-codegen</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-protobuf-maven-plugin</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-plugin-plugin</artifactId>
                    <version>4.0.0-beta-2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
