<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         >
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.champollion</groupId>
    <artifactId>champollion-parent</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Champollion</name>
    <description>Implémentation Jakarta JSON Processing 2.1 + Jakarta JSON Binding 3.0 — zéro dépendance, virtual threads, compilation statique (APT + plugin Maven)</description>
    <url>https://codefloe.com/Vidocq/champollion</url>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
    </developers>

    <!--
        Disjunctive triple license: a recipient may use this software under
        ANY ONE of the three licences below, at their option. EPL-2.0 is the
        anchor (see the LICENSE file); per EPL-2.0 section 1, GPL-2.0-or-later
        is offered as a Secondary License.
        SPDX-License-Identifier: EPL-2.0 OR EUPL-1.2 OR GPL-2.0-or-later
    -->
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://codefloe.com/Vidocq/champollion</url>
        <connection>scm:git:https://codefloe.com/Vidocq/champollion.git</connection>
        <developerConnection>scm:git:git@forge.vidocq.dev:vidocq/champollion.git</developerConnection>
    </scm>

    <properties>
        <!-- Specs Jakarta -->
        <jakarta.json.version>2.1.3</jakarta.json.version>
        <jakarta.json.bind.version>3.0.1</jakarta.json.bind.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <jmh.version>1.37</jmh.version>
    </properties>

    <!--
        champollion-tck joins the reactor only under the `tck` profile (see
        <profiles> below) — TCK harmonisation, same pattern as the
        vidocq-runtime-tck-* runners and the dirac pilot: a plain `mvn install`
        neither downloads nor runs anything TCK-related. The historical
        out-of-reactor constraint (ShrinkWrap Maven Resolver 3.3 vs Model 4.1.0
        POMs) disappeared with the Maven 3.9.16 / Model 4.0.0 migration.
        champollion-protobuf-tck keeps its own standalone execution model
        (executable conformance jar, not a Jakarta TCK).
    -->
    <modules>
        <module>champollion-api</module>
        <module>champollion-jsonp</module>
        <module>champollion-jsonb</module>
        <module>champollion-protobuf</module>
        <module>champollion-protobuf-codegen</module>
        <module>champollion-protobuf-maven-plugin</module>
        <module>champollion-codegen-apt</module>
        <module>champollion-codegen-maven-plugin</module>
        <module>champollion-bench</module>
        <module>champollion-examples</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Jakarta APIs -->
            <dependency>
                <groupId>jakarta.json</groupId>
                <artifactId>jakarta.json-api</artifactId>
                <version>${jakarta.json.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.json.bind</groupId>
                <artifactId>jakarta.json.bind-api</artifactId>
                <version>${jakarta.json.bind.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            <!-- JMH -->
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>

            <!-- Champollion modules internes -->
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-jsonp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-jsonb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-codegen-apt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-codegen-maven-plugin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-protobuf</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-protobuf-codegen</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-protobuf-maven-plugin</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-plugin-plugin</artifactId>
                    <version>4.0.0-beta-2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <!--
            TCK harmonisation: the official Jakarta JSON-P 2.1 / JSON-B 3.0 TCK
            runner joins the reactor only when this profile is active.

                ./mvnw -Ptck,jsonp-tck -pl champollion-tck test               # JSON-P api suite
                ./mvnw -Ptck,jsonp-tck-pluggability -pl champollion-tck test  # JSON-P pluggability
                ./mvnw -Ptck,jsonb-tck -pl champollion-tck test               # JSON-B suite

            run-official-tck-jsonp-2.1.sh / run-official-tck-jsonb-3.0.sh
            remain the friendly wrappers.
        -->
        <profile>
            <id>tck</id>
            <modules>
                <module>champollion-tck</module>
            </modules>
        </profile>
    </profiles>
</project>
