<?xml version="1.0" encoding="UTF-8"?>
<!--
    champollion-protobuf-tck est volontairement HORS reactor (POM Model 4.0.0
    standalone, sans <parent>) — même contrainte que cassini-tck / foy-tck /
    champollion-tck : ShrinkWrap Maven Resolver 3.3 ne sait pas parser les
    POMs Maven Model 4.1.0, et il scanne tout reactor courant.

    Invocation : ./run-official-conformance-protobuf.sh (depuis champollion/).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.vidocq.champollion</groupId>
    <artifactId>champollion-protobuf-tck</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Champollion :: Protobuf TCK (Conformance Runner)</name>
    <description>Wrapper du conformance_test_runner Google — pipe stdin/stdout, alimente le runtime Champollion en mode binaire et JSON canonical. Hors reactor pour contourner ShrinkWrap Maven Resolver 3.3 (cf. champollion-tck, cassini-tck, foy-tck).</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-protobuf</artifactId>
            <version>0.3.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>25</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.champollion</groupId>
                            <artifactId>champollion-protobuf-codegen</artifactId>
                            <version>0.3.0-SNAPSHOT</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.vidocq.champollion.protobuf.conformance.ConformanceRunner</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
