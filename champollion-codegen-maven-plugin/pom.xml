<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.champollion</groupId>
        <artifactId>champollion-parent</artifactId>
    </parent>

    <artifactId>champollion-codegen-maven-plugin</artifactId>
    <!--
        M0..M4 : packaging=jar (squelette).
        M5 : passera en packaging=maven-plugin avec activation du
        maven-plugin-plugin descriptor. Aujourd'hui maven-plugin-plugin 3.15.1
        utilise un ASM qui ne lit pas le bytecode Java 25 (major 69), donc le
        descriptor échouerait sur les transitives Maven 4 RC.
    -->
    <packaging>jar</packaging>
    <name>Champollion :: Codegen Maven Plugin (skeleton)</name>
    <description>Plugin Maven (squelette M0..M4) — scannera le classpath et déléguera la génération à champollion-codegen-apt en M5</description>

    <!-- Compile en Java 21 : aligné sur ce que les outils Maven 4 RC savent lire. -->
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>4.0.0-rc-5</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>3.15.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
